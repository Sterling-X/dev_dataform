config {
    type: "table",
    database: "sterlingx-insights",
    schema: "firm_marketing_client_performance",
    name: "firm_marketing_seo_engaged_sessions",
    tags: ["google analytics 4", "ga4", "seo", "engaged sessions", "client performance data"],
}

WITH am_roster AS (
  SELECT *
  FROM UNNEST([
    STRUCT('Aurit Mediation' AS client, 'Garrett' AS am),
    -- STRUCT('Badger Meter' AS client, 'Garrett' AS am),
    STRUCT('Bank Five Nine' AS client, 'Garrett' AS am),
    STRUCT('Blattner Family Law Group' AS client, 'Garrett' AS am),
    STRUCT('Cutrer Family Law' AS client, 'Dani' AS am),
    STRUCT('Elkus & Sisson' AS client, 'Dani' AS am),
    STRUCT('Fanash Family Law' AS client, 'Garrett' AS am),
    STRUCT('Five Star Bodies' AS client, 'Garrett' AS am),
    STRUCT('Gjesdahl Law' AS client, 'Dani' AS am),    
    STRUCT('Haffner Law' AS client, 'Garrett' AS am),
    -- STRUCT('Hicks Family Lawyers', 'Dani' AS am),
    STRUCT('Johnson Law Group' AS client, 'Garrett' AS am), 
    STRUCT('Kalish & Jaggars' AS client, 'Dani' AS am),       
    STRUCT('Lancaster Family Law' AS client, 'Dani' AS am),                
    STRUCT('Lisa Vance' AS client, 'Garrett' AS am),
    STRUCT('MeyerPink' AS client, 'Dani' AS am),
    STRUCT('Michael Ireland & Associates' AS client, 'Dani' AS am),
    -- STRUCT('Moran Wealth' AS client, 'Dani' AS am),
    STRUCT('Neuro Endo' AS client, 'Dani' AS am),
    STRUCT('Omnipress' AS client, 'Dani' AS am),
    STRUCT('Porcello Law Offices' AS client, 'Dani' AS am),
    -- STRUCT('Service Credit Union' AS client, 'Dani' AS am),
    STRUCT('Sterling Lawyers' AS client, 'Dani' AS am),
    -- STRUCT('The One Family Law', 'Dani' AS am),
    STRUCT('Ramage Law Firm' AS client, 'Dani' AS am)
  ])
),

base AS (
  SELECT
    SterlingX_Client_ID,
    SterlingX_Client_Name,
    'Aurit Mediation' AS client,
    event_date,
    sessionPrimaryChannelGroup,
    sessions,
    engaged_sessions
  FROM `sterlingx-insights.firm_marketing_googleanalytics4.aurit_googleanalytics4_session_organic`

  UNION ALL

  SELECT
    SterlingX_Client_ID,
    SterlingX_Client_Name,
    'Bank Five Nine' AS client,
    event_date,
    sessionPrimaryChannelGroup,
    sessions,
    engaged_sessions
  FROM `sterlingx-insights.firm_marketing_googleanalytics4.bankfivenine_googleanalytics4_session_organic`

  UNION ALL

  SELECT
    SterlingX_Client_ID,
    SterlingX_Client_Name,
    'Blattner Family Law Group' AS client,
    event_date,
    sessionPrimaryChannelGroup,
    sessions,
    engaged_sessions
  FROM `sterlingx-insights.firm_marketing_googleanalytics4.blattnerfamilylaw_googleanalytics4_session_organic`

  UNION ALL

  SELECT
    SterlingX_Client_ID,
    SterlingX_Client_Name,
    'Cutrer Family Law' AS client,
    event_date,
    sessionPrimaryChannelGroup,
    sessions,
    engaged_sessions
  FROM `sterlingx-insights.firm_marketing_googleanalytics4.cutrerlaw_googleanalytics4_session_organic`

  UNION ALL

  SELECT
    SterlingX_Client_ID,
    SterlingX_Client_Name,
    'Elkus & Sisson' AS client,
    event_date,
    sessionPrimaryChannelGroup,
    sessions,
    engaged_sessions
  FROM `sterlingx-insights.firm_marketing_googleanalytics4.elkussisson_googleanalytics4_session_organic`

  UNION ALL

  SELECT
    SterlingX_Client_ID,
    SterlingX_Client_Name,
    'Fanash Family Law' AS client,
    event_date,
    sessionPrimaryChannelGroup,
    sessions,
    engaged_sessions
  FROM `sterlingx-insights.firm_marketing_googleanalytics4.fanashfamily_googleanalytics4_session_organic`

  UNION ALL

  SELECT
    SterlingX_Client_ID,
    SterlingX_Client_Name,
    'Five Star Bodies' AS client,
    event_date,
    sessionPrimaryChannelGroup,
    sessions,
    engaged_sessions
  FROM `sterlingx-insights.firm_marketing_googleanalytics4.fivestarbodies_googleanalytics4_session_organic`

  UNION ALL

  SELECT
    SterlingX_Client_ID,
    SterlingX_Client_Name,
    'Gjesdahl Law' AS client,
    event_date,
    sessionPrimaryChannelGroup,
    sessions,
    engaged_sessions
  FROM `sterlingx-insights.firm_marketing_googleanalytics4.gjesdahllaw_googleanalytics4_session_organic`

  UNION ALL

  SELECT
    SterlingX_Client_ID,
    SterlingX_Client_Name,
    'Haffner Law' AS client,
    event_date,
    sessionPrimaryChannelGroup,
    sessions,
    engaged_sessions
  FROM `sterlingx-insights.firm_marketing_googleanalytics4.haffnerlaw_googleanalytics4_session_organic`

  UNION ALL

  SELECT
    SterlingX_Client_ID,
    SterlingX_Client_Name,
    'Johnson Law Group' AS client,
    event_date,
    sessionPrimaryChannelGroup,
    sessions,
    engaged_sessions
  FROM `sterlingx-insights.firm_marketing_googleanalytics4.johnsonlaw_googleanalytics4_session_organic`

  UNION ALL

  SELECT
    SterlingX_Client_ID,
    SterlingX_Client_Name,
    'Kalish & Jaggars' AS client,
    event_date,
    sessionPrimaryChannelGroup,
    sessions,
    engaged_sessions
  FROM `sterlingx-insights.firm_marketing_googleanalytics4.kalishjaggars_googleanalytics4_session_organic`

  UNION ALL

  SELECT
    SterlingX_Client_ID,
    SterlingX_Client_Name,
    'Lancaster Family Law' AS client,
    event_date,
    sessionPrimaryChannelGroup,
    sessions,
    engaged_sessions
  FROM `sterlingx-insights.firm_marketing_googleanalytics4.lancasterlaw_googleanalytics4_session_organic`

  UNION ALL

  SELECT
    SterlingX_Client_ID,
    SterlingX_Client_Name,
    'Lisa Vance' AS client,
    event_date,
    sessionPrimaryChannelGroup,
    sessions,
    engaged_sessions
  FROM `sterlingx-insights.firm_marketing_googleanalytics4.lisavance_googleanalytics4_session_organic`

  UNION ALL

  SELECT
    SterlingX_Client_ID,
    SterlingX_Client_Name,
    'MeyerPink' AS client,
    event_date,
    sessionPrimaryChannelGroup,
    sessions,
    engaged_sessions
  FROM `sterlingx-insights.firm_marketing_googleanalytics4.meyerpinklaw_googleanalytics4_session_organic`

  UNION ALL

  SELECT
    SterlingX_Client_ID,
    SterlingX_Client_Name,
    'Michael Ireland & Associates' AS client,
    event_date,
    sessionPrimaryChannelGroup,
    sessions,
    engaged_sessions
  FROM `sterlingx-insights.firm_marketing_googleanalytics4.ireland_googleanalytics4_session_organic`

  UNION ALL

  SELECT
    SterlingX_Client_ID,
    SterlingX_Client_Name,
    'Neuro Endo' AS client,
    event_date,
    sessionPrimaryChannelGroup,
    sessions,
    engaged_sessions
  FROM `sterlingx-insights.firm_marketing_googleanalytics4.neuroendo_googleanalytics4_session_organic`

  UNION ALL

  SELECT
    SterlingX_Client_ID,
    SterlingX_Client_Name,
    'Omnipress' AS client,
    event_date,
    sessionPrimaryChannelGroup,
    sessions,
    engaged_sessions
  FROM `sterlingx-insights.firm_marketing_googleanalytics4.omnipress_googleanalytics4_session_organic`

  UNION ALL

  SELECT
    SterlingX_Client_ID,
    SterlingX_Client_Name,
    'Porcello Law Offices' AS client,
    event_date,
    sessionPrimaryChannelGroup,
    sessions,
    engaged_sessions
  FROM `sterlingx-insights.firm_marketing_googleanalytics4.porcellolawoffices_googleanalytics4_session_organic`

  UNION ALL

  SELECT
    SterlingX_Client_ID,
    SterlingX_Client_Name,
    'Sterling Lawyers' AS client,
    event_date,
    sessionPrimaryChannelGroup,
    sessions,
    engaged_sessions
  FROM `sterlingx-insights.firm_marketing_googleanalytics4.sterlinglawyers_googleanalytics4_session_organic`

  UNION ALL

  SELECT
    SterlingX_Client_ID,
    SterlingX_Client_Name,
    'Ramage Law Firm' AS client,
    event_date,
    sessionPrimaryChannelGroup,
    sessions,
    engaged_sessions
  FROM `sterlingx-insights.firm_marketing_googleanalytics4.ramagelaw_googleanalytics4_session_organic`

),

data_availability AS (
  SELECT
    MAX(event_date) AS report_end_date
  FROM base
  WHERE event_date IS NOT NULL
),

date_windows AS (
  SELECT
    report_end_date,

    -- 90 Days
    DATE_SUB(report_end_date, INTERVAL 89 DAY) AS current_90_days_start_date,
    report_end_date AS current_90_days_end_date,

    DATE_SUB(report_end_date, INTERVAL 179 DAY) AS prior_90_days_start_date,
    DATE_SUB(report_end_date, INTERVAL 90 DAY) AS prior_90_days_end_date,

    DATE_SUB(DATE_SUB(report_end_date, INTERVAL 89 DAY), INTERVAL 1 YEAR) AS yoy_90_days_start_date,
    DATE_SUB(report_end_date, INTERVAL 1 YEAR) AS yoy_90_days_end_date,

    -- 30 Days
    DATE_SUB(report_end_date, INTERVAL 29 DAY) AS current_30_days_start_date,
    report_end_date AS current_30_days_end_date,

    DATE_SUB(report_end_date, INTERVAL 59 DAY) AS prior_30_days_start_date,
    DATE_SUB(report_end_date, INTERVAL 30 DAY) AS prior_30_days_end_date,

    DATE_SUB(DATE_SUB(report_end_date, INTERVAL 29 DAY), INTERVAL 1 YEAR) AS yoy_30_days_start_date,
    DATE_SUB(report_end_date, INTERVAL 1 YEAR) AS yoy_30_days_end_date,

    -- 14 Days
    DATE_SUB(report_end_date, INTERVAL 13 DAY) AS current_14_days_start_date,
    report_end_date AS current_14_days_end_date,

    DATE_SUB(report_end_date, INTERVAL 27 DAY) AS prior_14_days_start_date,
    DATE_SUB(report_end_date, INTERVAL 14 DAY) AS prior_14_days_end_date,

    DATE_SUB(DATE_SUB(report_end_date, INTERVAL 13 DAY), INTERVAL 1 YEAR) AS yoy_14_days_start_date,
    DATE_SUB(report_end_date, INTERVAL 1 YEAR) AS yoy_14_days_end_date,

    -- 12-Month YoY
    -- Uses YEAR intervals instead of 365 days to stay calendar-aligned during leap years.
    -- Example when report_end_date = 2026-06-29:
    -- current_yoy: 2025-06-30 through 2026-06-29
    -- prior_yoy:   2024-06-30 through 2025-06-29
    DATE_ADD(DATE_SUB(report_end_date, INTERVAL 1 YEAR), INTERVAL 1 DAY) AS current_yoy_start_date,
    report_end_date AS current_yoy_end_date,

    DATE_ADD(DATE_SUB(report_end_date, INTERVAL 2 YEAR), INTERVAL 1 DAY) AS prior_yoy_start_date,
    DATE_SUB(report_end_date, INTERVAL 1 YEAR) AS prior_yoy_end_date
  FROM data_availability
),

client_rollup AS (
  SELECT
    r.client,
    r.am,
    b.sessionPrimaryChannelGroup,

    MAX(b.SterlingX_Client_ID) AS SterlingX_Client_ID,
    MAX(b.SterlingX_Client_Name) AS SterlingX_Client_Name,

    dw.report_end_date,

    dw.current_90_days_start_date,
    dw.current_90_days_end_date,
    dw.prior_90_days_start_date,
    dw.prior_90_days_end_date,
    dw.yoy_90_days_start_date,
    dw.yoy_90_days_end_date,

    dw.current_30_days_start_date,
    dw.current_30_days_end_date,
    dw.prior_30_days_start_date,
    dw.prior_30_days_end_date,
    dw.yoy_30_days_start_date,
    dw.yoy_30_days_end_date,

    dw.current_14_days_start_date,
    dw.current_14_days_end_date,
    dw.prior_14_days_start_date,
    dw.prior_14_days_end_date,
    dw.yoy_14_days_start_date,
    dw.yoy_14_days_end_date,

    dw.current_yoy_start_date,
    dw.current_yoy_end_date,
    dw.prior_yoy_start_date,
    dw.prior_yoy_end_date,

    MAX(b.event_date) AS latest_reporting_data_date,

    -- 90 Days Sessions
    SUM(CASE WHEN b.event_date BETWEEN dw.current_90_days_start_date AND dw.current_90_days_end_date THEN COALESCE(b.sessions, 0) ELSE 0 END) AS sessions_90_days_current,
    SUM(CASE WHEN b.event_date BETWEEN dw.prior_90_days_start_date AND dw.prior_90_days_end_date THEN COALESCE(b.sessions, 0) ELSE 0 END) AS sessions_90_days_prior,
    SUM(CASE WHEN b.event_date BETWEEN dw.yoy_90_days_start_date AND dw.yoy_90_days_end_date THEN COALESCE(b.sessions, 0) ELSE 0 END) AS sessions_90_days_yoy,

    -- 90 Days Engaged Sessions
    SUM(CASE WHEN b.event_date BETWEEN dw.current_90_days_start_date AND dw.current_90_days_end_date THEN COALESCE(b.engaged_sessions, 0) ELSE 0 END) AS engaged_sessions_90_days_current,
    SUM(CASE WHEN b.event_date BETWEEN dw.prior_90_days_start_date AND dw.prior_90_days_end_date THEN COALESCE(b.engaged_sessions, 0) ELSE 0 END) AS engaged_sessions_90_days_prior,
    SUM(CASE WHEN b.event_date BETWEEN dw.yoy_90_days_start_date AND dw.yoy_90_days_end_date THEN COALESCE(b.engaged_sessions, 0) ELSE 0 END) AS engaged_sessions_90_days_yoy,

    -- 30 Days Sessions
    SUM(CASE WHEN b.event_date BETWEEN dw.current_30_days_start_date AND dw.current_30_days_end_date THEN COALESCE(b.sessions, 0) ELSE 0 END) AS sessions_30_days_current,
    SUM(CASE WHEN b.event_date BETWEEN dw.prior_30_days_start_date AND dw.prior_30_days_end_date THEN COALESCE(b.sessions, 0) ELSE 0 END) AS sessions_30_days_prior,
    SUM(CASE WHEN b.event_date BETWEEN dw.yoy_30_days_start_date AND dw.yoy_30_days_end_date THEN COALESCE(b.sessions, 0) ELSE 0 END) AS sessions_30_days_yoy,

    -- 30 Days Engaged Sessions
    SUM(CASE WHEN b.event_date BETWEEN dw.current_30_days_start_date AND dw.current_30_days_end_date THEN COALESCE(b.engaged_sessions, 0) ELSE 0 END) AS engaged_sessions_30_days_current,
    SUM(CASE WHEN b.event_date BETWEEN dw.prior_30_days_start_date AND dw.prior_30_days_end_date THEN COALESCE(b.engaged_sessions, 0) ELSE 0 END) AS engaged_sessions_30_days_prior,
    SUM(CASE WHEN b.event_date BETWEEN dw.yoy_30_days_start_date AND dw.yoy_30_days_end_date THEN COALESCE(b.engaged_sessions, 0) ELSE 0 END) AS engaged_sessions_30_days_yoy,

    -- 14 Days Sessions
    SUM(CASE WHEN b.event_date BETWEEN dw.current_14_days_start_date AND dw.current_14_days_end_date THEN COALESCE(b.sessions, 0) ELSE 0 END) AS sessions_14_days_current,
    SUM(CASE WHEN b.event_date BETWEEN dw.prior_14_days_start_date AND dw.prior_14_days_end_date THEN COALESCE(b.sessions, 0) ELSE 0 END) AS sessions_14_days_prior,
    SUM(CASE WHEN b.event_date BETWEEN dw.yoy_14_days_start_date AND dw.yoy_14_days_end_date THEN COALESCE(b.sessions, 0) ELSE 0 END) AS sessions_14_days_yoy,

    -- 14 Days Engaged Sessions
    SUM(CASE WHEN b.event_date BETWEEN dw.current_14_days_start_date AND dw.current_14_days_end_date THEN COALESCE(b.engaged_sessions, 0) ELSE 0 END) AS engaged_sessions_14_days_current,
    SUM(CASE WHEN b.event_date BETWEEN dw.prior_14_days_start_date AND dw.prior_14_days_end_date THEN COALESCE(b.engaged_sessions, 0) ELSE 0 END) AS engaged_sessions_14_days_prior,
    SUM(CASE WHEN b.event_date BETWEEN dw.yoy_14_days_start_date AND dw.yoy_14_days_end_date THEN COALESCE(b.engaged_sessions, 0) ELSE 0 END) AS engaged_sessions_14_days_yoy,

    -- 12-Month YoY Sessions
    SUM(CASE WHEN b.event_date BETWEEN dw.current_yoy_start_date AND dw.current_yoy_end_date THEN COALESCE(b.sessions, 0) ELSE 0 END) AS sessions_yoy_current,
    SUM(CASE WHEN b.event_date BETWEEN dw.prior_yoy_start_date AND dw.prior_yoy_end_date THEN COALESCE(b.sessions, 0) ELSE 0 END) AS sessions_yoy_prior,

    -- 12-Month YoY Engaged Sessions
    SUM(CASE WHEN b.event_date BETWEEN dw.current_yoy_start_date AND dw.current_yoy_end_date THEN COALESCE(b.engaged_sessions, 0) ELSE 0 END) AS engaged_sessions_yoy_current,
    SUM(CASE WHEN b.event_date BETWEEN dw.prior_yoy_start_date AND dw.prior_yoy_end_date THEN COALESCE(b.engaged_sessions, 0) ELSE 0 END) AS engaged_sessions_yoy_prior

  FROM am_roster r
  CROSS JOIN date_windows dw
  LEFT JOIN base b
    ON r.client = b.client
   AND b.event_date BETWEEN LEAST(
                          dw.prior_yoy_start_date,
                          dw.yoy_90_days_start_date,
                          dw.prior_90_days_start_date,
                          dw.current_90_days_start_date
                        )
                        AND dw.report_end_date
  GROUP BY
    r.client,
    r.am,
    b.sessionPrimaryChannelGroup,

    dw.report_end_date,

    dw.current_90_days_start_date,
    dw.current_90_days_end_date,
    dw.prior_90_days_start_date,
    dw.prior_90_days_end_date,
    dw.yoy_90_days_start_date,
    dw.yoy_90_days_end_date,

    dw.current_30_days_start_date,
    dw.current_30_days_end_date,
    dw.prior_30_days_start_date,
    dw.prior_30_days_end_date,
    dw.yoy_30_days_start_date,
    dw.yoy_30_days_end_date,

    dw.current_14_days_start_date,
    dw.current_14_days_end_date,
    dw.prior_14_days_start_date,
    dw.prior_14_days_end_date,
    dw.yoy_14_days_start_date,
    dw.yoy_14_days_end_date,

    dw.current_yoy_start_date,
    dw.current_yoy_end_date,
    dw.prior_yoy_start_date,
    dw.prior_yoy_end_date
)

SELECT
  client,
  am,
  sessionPrimaryChannelGroup,

  -- 90 Days
  COALESCE(sessions_90_days_current, 0) AS sessions_90_days_current,
  COALESCE(sessions_90_days_prior, 0) AS sessions_90_days_prior,
  COALESCE(sessions_90_days_yoy, 0) AS sessions_90_days_yoy,

  COALESCE(engaged_sessions_90_days_current, 0) AS engaged_sessions_90_days_current,
  COALESCE(engaged_sessions_90_days_prior, 0) AS engaged_sessions_90_days_prior,
  COALESCE(engaged_sessions_90_days_yoy, 0) AS engaged_sessions_90_days_yoy,

  -- 30 Days
  COALESCE(sessions_30_days_current, 0) AS sessions_30_days_current,
  COALESCE(sessions_30_days_prior, 0) AS sessions_30_days_prior,
  COALESCE(sessions_30_days_yoy, 0) AS sessions_30_days_yoy,

  COALESCE(engaged_sessions_30_days_current, 0) AS engaged_sessions_30_days_current,
  COALESCE(engaged_sessions_30_days_prior, 0) AS engaged_sessions_30_days_prior,
  COALESCE(engaged_sessions_30_days_yoy, 0) AS engaged_sessions_30_days_yoy,

  -- 14 Days
  COALESCE(sessions_14_days_current, 0) AS sessions_14_days_current,
  COALESCE(sessions_14_days_prior, 0) AS sessions_14_days_prior,
  COALESCE(sessions_14_days_yoy, 0) AS sessions_14_days_yoy,

  COALESCE(engaged_sessions_14_days_current, 0) AS engaged_sessions_14_days_current,
  COALESCE(engaged_sessions_14_days_prior, 0) AS engaged_sessions_14_days_prior,
  COALESCE(engaged_sessions_14_days_yoy, 0) AS engaged_sessions_14_days_yoy,

  -- Trailing 12-Month YoY
  COALESCE(sessions_yoy_current, 0) AS sessions_yoy_current,
  COALESCE(sessions_yoy_prior, 0) AS sessions_yoy_prior,

  COALESCE(engaged_sessions_yoy_current, 0) AS engaged_sessions_yoy_current,
  COALESCE(engaged_sessions_yoy_prior, 0) AS engaged_sessions_yoy_prior,

  -- Date Frames
  latest_reporting_data_date,

  current_90_days_start_date,
  current_90_days_end_date,
  prior_90_days_start_date,
  prior_90_days_end_date,
  yoy_90_days_start_date,
  yoy_90_days_end_date,

  current_30_days_start_date,
  current_30_days_end_date,
  prior_30_days_start_date,
  prior_30_days_end_date,
  yoy_30_days_start_date,
  yoy_30_days_end_date,

  current_14_days_start_date,
  current_14_days_end_date,
  prior_14_days_start_date,
  prior_14_days_end_date,
  yoy_14_days_start_date,
  yoy_14_days_end_date,

  current_yoy_start_date,
  current_yoy_end_date,
  prior_yoy_start_date,
  prior_yoy_end_date,

  SterlingX_Client_ID,
  SterlingX_Client_Name

FROM client_rollup
ORDER BY
  client,
  sessionPrimaryChannelGroup

