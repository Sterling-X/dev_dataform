config {
  type: "table",
  database: "sterlingx-insights",
  schema: "firm_marketing_localbrandmanager",
  name: "omnipress_localbrandmanager_individual_reviews",
  tags: ["local brand manager", "individual reviews", "review management", "marketing data", "omnipress"]
}

WITH reviews AS (
  SELECT
    record_key,
    remote_id AS raw_remote_id,
    business_id,
    ingested_at,
    ingestion_date,

    -- Review fields
    SAFE_CAST(JSON_VALUE(raw_json, '$.created_at') AS TIMESTAMP) AS created_at,
    SAFE_CAST(JSON_VALUE(raw_json, '$.deleted_at') AS TIMESTAMP) AS deleted_at,

    JSON_VALUE(raw_json, '$.location_name') AS review_location_name,
    JSON_VALUE(raw_json, '$.location_place_id') AS location_place_id,

    SAFE_CAST(JSON_VALUE(raw_json, '$.rating') AS INT64) AS rating,

    JSON_VALUE(raw_json, '$.remote_id') AS review_id,
    JSON_VALUE(raw_json, '$.remote_location_id') AS remote_location_id,

    JSON_VALUE(raw_json, '$.reply') AS reply,

    -- Reviewer
    JSON_VALUE(raw_json, '$.reviewer.display_name') AS reviewer_display_name,
    JSON_VALUE(raw_json, '$.reviewer.profile_photo_url') AS reviewer_profile_photo_url,

    -- Review content
    JSON_VALUE(raw_json, '$.text') AS review_text,

    SAFE_CAST(JSON_VALUE(raw_json, '$.updated_at') AS TIMESTAMP) AS updated_at

  FROM `rc-datamart-adminreport.local_brand_manager.raw_lbm_gmb_reviews`

  QUALIFY ROW_NUMBER() OVER (
    PARTITION BY COALESCE(
      JSON_VALUE(raw_json, '$.remote_id'),
      remote_id,
      record_key
    )
    ORDER BY ingested_at DESC
  ) = 1
),

location AS (
  SELECT
    record_key,
    remote_id AS raw_location_remote_id,
    business_id,
    ingested_at,
    ingestion_date,

    JSON_VALUE(raw_json, '$.address') AS address,
    JSON_VALUE(raw_json, '$.administrative_area') AS administrative_area,
    JSON_VALUE(raw_json, '$.city') AS city,
    JSON_VALUE(raw_json, '$.country') AS country,

    SAFE_CAST(JSON_VALUE(raw_json, '$.created_at') AS TIMESTAMP) AS created_at,

    SAFE_CAST(JSON_VALUE(raw_json, '$.enabled') AS BOOL) AS enabled,
    SAFE_CAST(JSON_VALUE(raw_json, '$.enabled_at') AS TIMESTAMP) AS enabled_at,

    JSON_VALUE(raw_json, '$.gbp_id') AS gbp_id,
    JSON_VALUE(raw_json, '$.gmb_url') AS gmb_url,
    JSON_VALUE(raw_json, '$.id') AS id,

    SAFE_CAST(
      JSON_VALUE(raw_json, '$.keywords_synced_at') AS TIMESTAMP
    ) AS keywords_synced_at,

    SAFE_CAST(JSON_VALUE(raw_json, '$.lat') AS FLOAT64) AS lat,
    SAFE_CAST(JSON_VALUE(raw_json, '$.lng') AS FLOAT64) AS lng,

    JSON_VALUE(raw_json, '$.name') AS name,
    JSON_VALUE(raw_json, '$.note') AS note,
    JSON_VALUE(raw_json, '$.phone_number') AS phone_number,
    JSON_VALUE(raw_json, '$.place_id') AS place_id,
    JSON_VALUE(raw_json, '$.postal_code') AS postal_code,
    JSON_VALUE(raw_json, '$.primary_category') AS primary_category,
    JSON_VALUE(raw_json, '$.source_type') AS source_type,
    JSON_VALUE(raw_json, '$.store_code') AS store_code,
    JSON_VALUE(raw_json, '$.website_url') AS website_url,

    -- Arrays
    JSON_VALUE_ARRAY(raw_json, '$.additional_categories') AS additional_categories,
    JSON_VALUE_ARRAY(raw_json, '$.labels') AS labels,
    JSON_VALUE_ARRAY(raw_json, '$.states') AS states,
    JSON_VALUE_ARRAY(raw_json, '$.tags') AS tags,

    -- Object
    JSON_QUERY(raw_json, '$.regular_hours') AS regular_hours

  FROM `rc-datamart-adminreport.local_brand_manager.raw_lbm_locations`

  QUALIFY ROW_NUMBER() OVER (
    PARTITION BY JSON_VALUE(raw_json, '$.gbp_id')
    ORDER BY ingested_at DESC
  ) = 1
)

SELECT
  '1a402c5a-b3e7-4fc6-9f2e-cbd4c5ffe02a' AS SterlingX_Client_ID,
   'Omnipress' AS SterlingX_Client_Name,

  l.id AS location_id,
  l.gbp_id AS location_gbp_id,
  l.place_id AS location_place_id,
  l.name AS location_name,
  l.address AS location_address,
  l.city AS location_city,
  l.administrative_area AS location_state,
  l.postal_code AS location_postal_code,
  l.country AS location_country,
  l.gmb_url AS location_gmb_url,

  r.review_id,
  r.reviewer_display_name,
  r.reviewer_profile_photo_url,
  r.rating,
  r.review_text,
  r.reply,

  r.created_at AS review_created_at,
  r.updated_at AS review_updated_at,

  DATE(r.created_at) AS review_date,
  FORMAT_DATE('%Y-%m', DATE(r.created_at)) AS review_year_month,

  CASE
    WHEN r.reply IS NOT NULL
      AND TRIM(r.reply) != ''
    THEN TRUE
    ELSE FALSE
  END AS has_reply,

  CASE
    WHEN DATE(r.created_at) >= DATE_TRUNC(CURRENT_DATE(), MONTH)
      AND DATE(r.created_at) < DATE_ADD(
        DATE_TRUNC(CURRENT_DATE(), MONTH),
        INTERVAL 1 MONTH
      )
    THEN TRUE
    ELSE FALSE
  END AS is_new_review_current_month,

  -- Ingestion metadata
  r.ingested_at AS review_ingested_at,
  r.ingestion_date AS review_ingestion_date

FROM reviews r

INNER JOIN location l
  ON r.remote_location_id = l.gbp_id

WHERE r.remote_location_id = '15970255129925115214'
  AND r.deleted_at IS NULL
  