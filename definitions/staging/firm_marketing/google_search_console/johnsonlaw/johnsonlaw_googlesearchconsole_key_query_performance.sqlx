config {
    type: "table",
    database: "sterlingx-insights",
    schema: "firm_marketing_googlesearchconsole",
    name: "johnsonlaw_googlesearchconsole_key_query_performance",
    tags: ["google search console", "key query performance", "johnsonlaw"],
}

WITH key_query_performance AS (

  SELECT
    data_date AS date,
    query,

    -- Total impressions
    SUM(impressions) AS impressions,

    -- Additive numerator for GSC Average Position
    SUM(
      CASE
        WHEN position IS NOT NULL
        THEN position * impressions
        ELSE 0
      END
    ) AS position_weighted_sum,

    -- Additive denominator for GSC Average Position
    SUM(
      CASE
        WHEN position IS NOT NULL
        THEN impressions
        ELSE 0
      END
    ) AS position_weighted_impressions

  FROM
    `rc-datamart-adminreport.google_search_console_johnsonlaw.fct_gsc_key_query_performance`

  GROUP BY
    data_date,
    query
)

SELECT
  '0c4e2f26-cf3d-41e3-978f-8cd31726062f' AS SterlingX_Client_ID,
  'Johnson Law Group' AS SterlingX_Client_Name,
  date,
  query,

  -- Daily/query position
  SAFE_DIVIDE(
    position_weighted_sum,
    position_weighted_impressions
  ) AS position,

  impressions,

  -- Keep these for correct aggregation across dates/queries
  position_weighted_sum,
  position_weighted_impressions

FROM key_query_performance