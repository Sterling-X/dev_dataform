config {
  type: "table",
  database: "sterlingx-insights",
  schema: "firm_marketing_googleads_weekly_roundup",
  name: "porcellolawoffices_googleads_conversion_action_weekly_roundup",
  tags: ["google ads", "conversion action", "marketing data", "weekly roundup", "porcellolawoffices"],
}

WITH base AS (

  SELECT
    DATE(segment_date) AS segment_date,

    SterlingX_Client_ID,
    SterlingX_Client_Name,

    CAST(customer_id AS STRING) AS customer_id,
    customer_name,

    CAST(campaign_id AS STRING) AS campaign_id,
    campaign_name,

    CAST(conversion_action_id AS STRING) AS conversion_action_id,
    conversion_action_name,
    conversion_action_status,
    conversion_action_type,
    conversion_action_category,
    conversion_action_origin,

    primary_for_goal,
    include_in_conversions_metric,

    SAFE_CAST(conversions AS NUMERIC) AS conversions,
    SAFE_CAST(conversions_value AS NUMERIC) AS conversions_value,
    SAFE_CAST(all_conversions AS NUMERIC) AS all_conversions,
    SAFE_CAST(all_conversions_value AS NUMERIC) AS all_conversions_value
  FROM `sterlingx-insights.firm_marketing_googleads.porcellolawoffices_googleads_conversion_action_daily`

),

weekly AS (

  SELECT
    DATE_TRUNC(segment_date, WEEK(SUNDAY)) AS week_starting,

    SterlingX_Client_ID,
    SterlingX_Client_Name,

    customer_id,
    customer_name,

    campaign_id,
    campaign_name,

    conversion_action_id,
    conversion_action_name,
    conversion_action_status,
    conversion_action_type,
    conversion_action_category,
    conversion_action_origin,

    primary_for_goal,
    include_in_conversions_metric,

    SUM(COALESCE(conversions, 0)) AS conversions,
    SUM(COALESCE(conversions_value, 0)) AS conversions_value,
    SUM(COALESCE(all_conversions, 0)) AS all_conversions,
    SUM(COALESCE(all_conversions_value, 0)) AS all_conversions_value
  FROM base
  GROUP BY
    week_starting,
    SterlingX_Client_ID,
    SterlingX_Client_Name,
    customer_id,
    customer_name,
    campaign_id,
    campaign_name,
    conversion_action_id,
    conversion_action_name,
    conversion_action_status,
    conversion_action_type,
    conversion_action_category,
    conversion_action_origin,
    primary_for_goal,
    include_in_conversions_metric
)

SELECT
  week_starting,

  SterlingX_Client_ID,
  SterlingX_Client_Name,

  customer_id,
  customer_name,

  campaign_id,
  campaign_name,

  conversion_action_id,
  conversion_action_name,
  conversion_action_status,
  conversion_action_type,
  conversion_action_category,
  conversion_action_origin,

  primary_for_goal,
  include_in_conversions_metric,

  conversions,
  conversions_value,
  all_conversions,
  all_conversions_value
FROM weekly
ORDER BY
  week_starting DESC,
  customer_name,
  campaign_name,
  conversion_action_name
